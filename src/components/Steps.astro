---
import Icon from './Icon.astro';

const steps = [
  {
    title: 'Сентябрь: входная диагностика',
    text: 'Смотрю, что ребёнок уже умеет по пяти направлениям развития, и записываю исходные проценты в сводную таблицу.',
  },
  {
    title: 'Октябрь — апрель: среда и игра',
    text: 'Материалы и задания подстраиваются под группу: где проседает речь, там больше мнемотаблиц, где моторика, там шнуровки и лепка.',
  },
  {
    title: 'Май: повторная диагностика',
    text: 'Сравниваю с сентябрём и показываю прирост в процентных пунктах. Отсюда берутся цифры в разделе результатов.',
  },
];
---

<section class="section" id="process">
  <div class="container">
    <div class="section-head reveal">
      <div class="section-head__title">
        <p class="eyebrow"><Icon name="tree-structure" size={18} /> Как устроен учебный год</p>
        <h2>Три точки, по которым видно динамику</h2>
      </div>
      <p>Диагностика не ради бумаги: она меняет то, что происходит в группе с октября по апрель.</p>
    </div>

    <ol class="steps">
      {steps.map((step) => (
        <li class="step reveal">
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
