---
import Icon from './Icon.astro';

const items = [
  {
    icon: 'baby',
    title: 'Адаптация без спешки',
    text: 'Первый месяц в ясельной группе уходит на привыкание: короткий день, повторяющийся ритуал, спокойное расставание с родителем.',
  },
  {
    icon: 'chat-circle-text',
    title: 'Речь через мнемотаблицы',
    text: 'Пересказ сказки, стихотворение и загадка идут через картинку и символ. К концу года ребёнок рассказывает по схеме сам.',
  },
  {
    icon: 'hand-palm',
    title: 'Мелкая моторика каждый день',
    text: 'Пальчиковые игры, сенсорные коробки, лепка, шнуровки и мозаика стоят в расписании, а не появляются раз в неделю.',
  },
  {
    icon: 'users-three',
    title: 'Родители как партнёры',
    text: 'Собрания, досуги и выставки совместного творчества плюс личные консультации по режиму, речи и адаптации.',
  },
];
---

<section class="section section--sand" id="approach">
  <div class="container">
    <div class="section-head reveal">
      <div class="section-head__title">
        <p class="eyebrow"><Icon name="sparkle" size={18} /> Педагогический подход</p>
        <h2>Четыре вещи, которые делаются каждый день</h2>
      </div>
      <p>
        Не отдельные занятия для отчёта, а то, что повторяется в группе постоянно. Каждый пункт вырос из отчёта
        по самообразованию за конкретный год.
      </p>
    </div>

    <div class="benefits">
      {items.map((item) => (
        <article class="benefit reveal">
          <Icon name={item.icon} size={24} class="benefit__icon" />
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
